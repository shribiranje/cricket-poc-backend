{
  "name": "fantasy-poc-backend",
  "version": "1.0.0",
  "description": "Fantasy sports POC backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0 <23",
    "npm": ">=9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "db:init": "node src/utils/dbInit.js",
    "db:migrate:external-ids": "node -e \"console.error('001_external_ids.sql is not shipped on this branch \u2014 external_id columns are already in schema.sql. Use npm run db:init (fresh) or db:migrate:match-admin (poc_v2 deltas).'); process.exit(1)\"",
    "sportmonks:sync": "node src/utils/sportmonksSync.js",
    "sportmonks:leagues": "node src/utils/sportmonksLeagues.js",
    "db:migrate:match-admin": "node src/utils/runMigration.js 003_match_admin.sql",
    "db:migrate:predictions": "node src/utils/runMigration.js 004_predictions.sql",
    "rapidapi:probe": "node scripts/rapidapiProbe.js",
    "sportscore:probe": "node scripts/sportscoreProbe.js",
    "sportscore:sync": "node src/utils/sportscoreSync.js",
    "db:migrate:sportscore": "node src/utils/runMigration.js 005_sportscore.sql",
    "db:migrate:rapidapi-poll": "node src/utils/runMigration.js 007_rapidapi_poll_sessions.sql",
    "db:migrate:rapidapi-log": "node src/utils/runMigration.js 008_rapidapi_call_log.sql",
    "db:migrate:wallet-tx": "node src/utils/runMigration.js 009_wallet_transactions.sql",
    "db:migrate:app-settings": "node src/utils/runMigration.js 010_app_settings.sql",
    "rapidapi:sync": "node scripts/rapidapiSync.js",
    "rapidapi:sync-status": "node -e \"require('./src/services/rapidapi.service').syncStatuses().then(s=>{console.log(JSON.stringify(s,null,2));process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
